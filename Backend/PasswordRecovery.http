@baseUrl = http://localhost:5167
@email = player@example.com
@resetCode = copy-the-code-from-the-reset-email
@newPassword = ANewPassword123

### Check whether password recovery has been configured
GET {{baseUrl}}/api/auth/password-recovery/status

### Request a password reset email
POST {{baseUrl}}/api/auth/forgotPassword
Content-Type: application/json

{
  "email": "{{email}}"
}

### Reset the password with the one-time code from the email
POST {{baseUrl}}/api/auth/resetPassword
Content-Type: application/json

{
  "email": "{{email}}",
  "resetCode": "{{resetCode}}",
  "newPassword": "{{newPassword}}"
}
